{
  "name": "@ickb/validation",
  "version": "1001.0.0",
  "private": true,
  "description": "Private live validation core for iCKB tester and supervisor flows",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "pnpm --workspace-root exec eslint --max-warnings=0 packages/validation/src packages/validation/test"
  },
  "dependencies": {
    "@ckb-ccc/core": "catalog:",
    "@ickb/core": "workspace:*",
    "@ickb/node-utils": "workspace:*",
    "@ickb/order": "workspace:*",
    "@ickb/sdk": "workspace:*"
  },
  "devDependencies": {
    "@ickb/testkit": "workspace:*",
    "@types/node": "catalog:"
  }
}
