{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/{run-node-tests,tooling/build/rewrite-dts-imports}.ts!",
        "scripts/test/**/*.ts",
        "!scripts/test/**/*support.ts",
      ],
      "includeEntryExports": true,
      "project": ["scripts/**/*.ts", "!scripts/test/**!", "*.config.{ts,mts}"],
    },
    // `!` marks production entries and files: `knip --production` runs in the gate.
    "sdk": {
      "project": ["src/**/*.ts!", "test/**/*.ts"],
    },
    "testkit": {
      "project": ["src/**/*.ts!", "test/**/*.ts"],
    },
    "sdk/node": {
      "entry": ["src/{bot,sampler,stimulus}.ts!"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
    },
    "interface": {
      "ignoreDependencies": ["tailwindcss"],
      "project": ["src/**/*.{ts,tsx,css}!", "test/**/*.{ts,tsx}"],
    },
  },
  "ignoreUnresolved": ["/favicon.png?url"],
  // Production mode reports exports only tests import. A helper that its own file
  // calls is not a mock seam, so keep the lane for dead code and test-only barrels.
  "ignoreExportsUsedInFile": true,
}
