{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/{lint-source-structure,run-node-tests,tooling/build/rewrite-dts-imports,live/{config-from-env,preflight}}.ts",
        "scripts/test/**/*.ts",
        "!scripts/test/**/*support.ts",
      ],
      "includeEntryExports": true,
      "project": ["scripts/**/*.ts", "*.config.{ts,mts}"],
    },
    "apps/interface": {
      "ignoreDependencies": ["tailwindcss"],
    },
  },
  "ignoreUnresolved": ["/favicon.png?url"],
}
