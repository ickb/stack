exports[`RateChart > lays the unscaled labels and the tip dot over the stretched plot > rate chart markup 1`] = `"<figure class="grid h-full grid-rows-[2rem_minmax(0,1fr)_4.5rem] sm:grid-rows-[2rem_minmax(0,1fr)_3.25rem]"><figcaption class="flex items-end justify-center text-center"><span class="text-lg font-medium text-ickb-text/90"><span class="text-xl font-bold text-ickb-text">1 iCKB</span> worth over time</span></figcaption><div class="grid min-h-0 grid-cols-[4.75rem_minmax(0,1fr)] gap-x-2 sm:grid-cols-[6.5rem_minmax(0,1fr)]"><div class="relative min-h-0"><span class="absolute right-0 translate-y-[-50%] text-sm whitespace-nowrap text-ickb-muted sm:text-base" style="top:74.24242424242425%">1 CKB</span><span class="absolute right-0 translate-y-[-50%] text-sm whitespace-nowrap text-ickb-muted sm:text-base" style="top:43.93939393939394%">1.1 CKB</span><span class="absolute right-0 translate-y-[-50%] text-sm whitespace-nowrap text-ickb-muted sm:text-base" style="top:13.636363636363635%">1.2 CKB</span></div><div class="relative min-h-0"><svg viewBox="0 0 640 132" preserveAspectRatio="none" role="img" aria-labelledby="rate-chart-title rate-chart-desc" class="absolute inset-0 h-full w-full overflow-visible"><title id="rate-chart-title">1 iCKB worth over time:</title><desc id="rate-chart-desc">Protocol-derived Mainnet curve from 2019 to 2026, showing 1 iCKB changing from 1 CKB to 1.2 CKB.</desc><g><line x1="10" x2="606" y1="98" y2="98" vector-effect="non-scaling-stroke" class="stroke-ickb-border/60"></line></g><g><line x1="10" x2="606" y1="58" y2="58" vector-effect="non-scaling-stroke" class="stroke-ickb-border/60"></line></g><g><line x1="10" x2="606" y1="18" y2="18" vector-effect="non-scaling-stroke" class="stroke-ickb-border/60"></line></g><polyline points="10,98 27.028571427008462,94.99599873780151 44.05714285689607,92.05955014104664 61.08571428390454,89.18723121437269 78.11428571379214,86.37588349068251 95.1428571408006,83.62258593596756 112.17142857068822,80.9246312