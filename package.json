{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @ickb/sdk build && node scripts/tooling/build/rewrite-dts-imports.ts --check sdk/dist",
    "check": "CI=true pnpm audit && CI=true pnpm lint && CI=true pnpm --filter ./interface build",
    "lint": "pnpm lint:typecheck && pnpm lint:format && pnpm lint:duplication && pnpm lint:knip && pnpm lint:architecture && pnpm lint:api && pnpm lint:publish && pnpm lint:coverage && pnpm lint:eslint",
    "lint:typecheck": "tsgo --noEmit -p tsconfig.json && pnpm --filter ./interface lint:typecheck",
    "lint:format": "prettier --check .",
    "lint:duplication": "jscpd --min-lines 12 --min-tokens 100 --threshold 0.1 --reporters console --format typescript,tsx sdk testkit interface scripts",
    "lint:knip": "knip --no-progress && knip --production --no-progress && node scripts/tooling/dead-members.ts",
    "lint:architecture": "depcruise --config .dependency-cruiser.jsonc sdk testkit interface scripts",
    "lint:api": "pnpm build && pnpm --filter @ickb/sdk lint:api",
    "lint:publish": "pnpm --filter @ickb/sdk lint:publish",
    "lint:coverage": "vitest run --coverage && node scripts/run-node-tests.ts",
    "lint:eslint:files": "eslint \"scripts/**/*.ts\" \"eslint.config.mts\" \"prettier.config.mts\" \"vitest.config.mts\" \"{sdk,sdk/node,testkit,interface}/vitest.config.mts\" \"interface/vite.config.ts\" \"{sdk,sdk/node,testkit,interface}/{src,test}/**/*.{ts,tsx}\"",
    "lint:eslint": "pnpm lint:eslint:files --max-warnings=0",
    "format": "pnpm lint:eslint:files --fix && prettier --write .",
    "test": "vitest"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.3",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "76.0.0",
    "fast-check": "^4.10.2",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
