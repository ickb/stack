{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @ickb/sdk build && node scripts/tooling/build/rewrite-dts-imports.ts --check sdk/dist",
    "node:install": "CI=true pnpm --filter @ickb/node... install --frozen-lockfile",
    "node:check": "pnpm --filter @ickb/node exec tsgo --noEmit -p tsconfig.json",
    "check": "CI=true pnpm audit && CI=true pnpm lint && CI=true pnpm --filter ./interface build",
    "lint": "pnpm lint:typecheck && pnpm lint:format && pnpm lint:duplication && pnpm lint:knip && pnpm lint:architecture && pnpm lint:api && pnpm lint:publish && pnpm lint:coverage && pnpm lint:eslint",
    "lint:typecheck": "tsgo --noEmit -p tsconfig.json && pnpm --filter ./interface lint:typecheck",
    "lint:format": "prettier --check .",
    "lint:duplication": "jscpd --min-lines 12 --min-tokens 100 --threshold 0.1 --reporters console --format typescript,tsx sdk testkit interface scripts",
    "lint:knip": "knip --no-progress && knip --production --no-progress",
    "lint:architecture": "depcruise --config .dependency-cruiser.jsonc sdk testkit interface scripts",
    "lint:api": "pnpm build && pnpm --filter @ickb/sdk lint:api",
    "lint:publish": "pnpm --filter @ickb/sdk lint:publish",
    "lint:coverage": "vitest run --coverage && node scripts/run-node-tests.ts",
    "lint:eslint:files": "eslint \"scripts/**/*.ts\" \"eslint.config.mts\" \"prettier.config.mts\" \"vitest.config.mts\" \"{sdk,sdk/node,testkit,interface}/vitest.config.mts\" \"interface/vite.config.ts\" \"{sdk,sdk/node,testkit,interface}/{src,test}/**/*.{ts,tsx}\"",
    "lint:eslint": "pnpm lint:eslint:files --max-warnings=0",
    "format": "pnpm lint:eslint:files --fix && prettier --write .",
    "test": "vitest",
    "test:ci": "vitest run && node scripts/run-node-tests.ts",
    "clean": "rm -fr dist sdk/dist interface/dist */*.tsbuildinfo sdk/node/*.tsbuildinfo"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "^1.6.25",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "68.0.0",
    "fast-check": "^4.9.0",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
