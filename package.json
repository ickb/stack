{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && node scripts/tooling/build/rewrite-dts-imports.ts --check packages/*/dist",
    "build:all": "pnpm build && pnpm --filter ./apps/interface build",
    "bot:install": "CI=true pnpm --filter @ickb/bot-cli... install --frozen-lockfile",
    "bot:check": "pnpm --filter @ickb/bot-cli --filter @ickb/bot exec tsgo --noEmit -p tsconfig.json",
    "check": "CI=true pnpm check:base",
    "check:base": "pnpm clean:deep && pnpm install && pnpm audit && pnpm lint && pnpm --filter ./apps/interface build",
    "check:fresh": "rm -f pnpm-lock.yaml && pnpm check",
    "lint": "pnpm lint:typecheck && pnpm lint:format && pnpm lint:duplication && pnpm lint:structure && pnpm lint:knip && pnpm lint:architecture && pnpm lint:api && pnpm lint:publish && pnpm lint:coverage && pnpm lint:eslint",
    "lint:inspect": "status=0; for script in lint:typecheck lint:format lint:duplication lint:structure lint:knip lint:architecture lint:api lint:publish lint:coverage lint:eslint; do pnpm \"$script\" || status=1; done; exit \"$status\"",
    "lint:typecheck": "tsgo --noEmit -p tsconfig.json && pnpm --filter ./apps/interface lint:typecheck",
    "lint:format": "prettier --check .",
    "lint:duplication": "jscpd --min-lines 12 --min-tokens 100 --threshold 0.1 --reporters console --format typescript apps packages scripts",
    "lint:structure": "node scripts/lint-source-structure.ts",
    "lint:knip": "knip --no-progress",
    "lint:architecture": "depcruise --config .dependency-cruiser.jsonc apps packages scripts",
    "lint:api": "pnpm build && pnpm -r --filter './packages/*' lint:api",
    "lint:publish": "pnpm -r --if-present --filter './packages/*' lint:publish",
    "lint:coverage": "vitest run --coverage && node scripts/run-node-tests.ts",
    "lint:eslint:files": "eslint \"scripts/**/*.ts\" \"eslint.config.mts\" \"prettier.config.mts\" \"vitest.config.mts\" \"apps/*/vitest.config.mts\" \"packages/*/vitest.config.mts\" \"apps/interface/vite.config.ts\" \"apps/*/{src,test}/**/*.{ts,tsx}\" \"packages/*/{src,test}/**/*.{ts,tsx}\"",
    "lint:eslint": "pnpm lint:eslint:files --max-warnings=0",
    "format": "pnpm lint:eslint:files --fix && prettier --write .",
    "test": "vitest",
    "test:ci": "vitest run && node scripts/run-node-tests.ts",
    "clean": "rm -fr dist packages/*/dist apps/*/dist apps/*/*.tsbuildinfo packages/*/*.tsbuildinfo",
    "clean:deep": "pnpm clean && rm -fr node_modules packages/*/node_modules apps/*/node_modules",
    "live:generate-config": "node scripts/live/generate-config.ts",
    "live:check:source": "tsgo --noEmit -p tsconfig.json",
    "live:config-from-env": "node scripts/live/config-from-env.ts",
    "live:preflight": "node scripts/live/preflight.ts",
    "live:supervisor": "node apps/validation/src/supervisor.ts",
    "live:supervisor:bot-stimulus-test": "node apps/validation/src/liveBotStimulusTest.ts",
    "live:supervisor:loop": "node scripts/supervisor/loop-cli.ts",
    "live:supervisor:dynamic-loop": "node scripts/supervisor/dynamic-loop-cli.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "^1.6.25",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "68.0.0",
    "fast-check": "^4.9.0",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
