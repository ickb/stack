# iCKB testnet tester as a systemd user unit. The unit is the configuration: copy it to
# ~/.config/systemd/user/, edit every path and value, then follow apps/node/README.md.
# systemd expands % specifiers in every value, so a literal % must be written %%.
[Unit]
Description=iCKB tester testnet

[Service]
# Type=exec makes `systemctl start` fail when the node binary cannot be executed.
Type=exec
WorkingDirectory=/home/user/Projects/ickb/stack
# The user manager does not see the shell PATH, so name the node binary by absolute path.
ExecStart=/home/user/.local/share/fnm/node-versions/v24.18.0/installation/bin/node apps/node/src/tester.ts
Environment=TESTER_CHAIN=testnet
Environment="TESTER_RPC_URL=https://testnet.ckb.dev/"
# The key stays in a 0600 file: unit files, `systemctl show`, and child processes all expose Environment values.
Environment=TESTER_PRIVATE_KEY_FILE=/home/user/.config/ickb-bot/tester-testnet.key
# auto draws a scenario the account can afford each turn; name one for a hand-driven turn.
Environment=TESTER_SCENARIO=auto
# Exit 0 and 1 start the next turn after a minute; exit 2 is a hold until the operator restarts the unit.
Restart=always
RestartSec=60s
RestartPreventExitStatus=2
NoNewPrivileges=yes
# The process holds a private key, so never write a core file.
LimitCORE=0

[Install]
WantedBy=default.target
