{
  "name": "@ickb/node",
  "version": "1001.0.0",
  "description": "iCKB bot, testnet stimulus generator, and rate sampler",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bot": "node src/bot.ts",
    "stimulus": "node src/stimulus.ts",
    "sampler": "node src/sampler.ts | tee rate.csv",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "pnpm --workspace-root exec eslint --max-warnings=0 sdk/node/src sdk/node/test"
  },
  "dependencies": {
    "@ckb-ccc/core": "catalog:"
  },
  "devDependencies": {
    "@ickb/testkit": "workspace:*",
    "@types/node": "catalog:"
  }
}
